<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/img_passport"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="16dp"
    android:background="#FFFCFB"
    android:orientation="horizontal"
    android:weightSum="1">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.4"
        android:scaleType="fitCenter"
        tools:srcCompat="@drawable/img" />

    <RelativeLayout
        android:id="@+id/relative_infos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp"
        android:layout_weight="0.6"
        android:background="#FFFCFB"
        android:padding="16dp">

        <TextView
            android:id="@+id/titre_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="25dp"
            android:gravity="center"
            android:text="PASSPORT TEMPOREL"
            android:textColor="#5D1717"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="visible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/nom_voy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titre_pass"
            android:layout_marginTop="20dp"
            android:text="Nom: "
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/annee_naiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/nom_voy"
            android:layout_marginTop="14dp"
            android:text="Annee de naissance: "
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/annee_naiss"
            android:layout_marginTop="14dp"
            android:text="Destination"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/age_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/destination"
            android:layout_marginTop="14dp"
            android:text="Age Temporel: "
            android:textColor="#0F0DED"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/motif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/age_temp"
            android:layout_marginTop="14dp"
            android:text="Motif: "
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_approuv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="128dp"
            android:backgroundTint="#4CAF50"
            android:text="Approuver Le Saut Temporel" />

        <Button
            android:id="@+id/btn_refu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="64dp"
            android:backgroundTint="#BD1708"
            android:text="Refuser le saut temporel" />

    </RelativeLayout>

</LinearLayout>