<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_ot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="0dp"
    android:background="@drawable/background"
    android:hapticFeedbackEnabled="false"
    android:orientation="horizontal"
    android:weightSum="1">

    <ImageView
        android:id="@+id/img_pass_ot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_weight="0.3"
        android:scaleType="fitStart"
        tools:srcCompat="@drawable/avatar" />

    <RelativeLayout
        android:id="@+id/relative_infos_ot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_weight="0.7"
        android:background="#76000105"
        android:padding="16dp">

        <TextView
            android:id="@+id/titre_pass_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="PASSPORT TEMPOREL"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="visible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/nom_voy_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titre_pass_ot"
            android:layout_marginTop="20dp"
            android:text="Nom: "
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/annee_naiss_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/nom_voy_ot"
            android:layout_marginTop="14dp"
            android:text="Annee de naissance: "
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/destination_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/annee_naiss_ot"
            android:layout_marginTop="14dp"
            android:text="Destination"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/age_temp_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/destination_ot"
            android:layout_marginTop="14dp"
            android:text="Age Temporel: "
            android:textColor="#FF96B7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/motif_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/age_temp_ot"
            android:layout_marginTop="14dp"
            android:text="Motif: "
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_approuv_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="128dp"
            android:backgroundTint="#4CAF50"
            android:text="Approuver Le Saut Temporel" />

        <Button
            android:id="@+id/btn_refu_ot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="64dp"
            android:backgroundTint="#BD1708"
            android:text="Refuser le saut temporel" />

    </RelativeLayout>

</LinearLayout>